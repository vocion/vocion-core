#!/bin/bash
# First boot of a vocion-stack box (infra/terraform/modules/vocion-stack).
#
# Writes what the box needs to deploy itself (templates/box-files.sh.tftpl),
# then runs the first deploy. Every later deploy goes through the module's
# deploy document (output deploy_document_name), which writes the same files
# again first. Log: /var/log/cloud-init-output.log
set -euo pipefail

${box_files}

if /usr/local/sbin/vocion-deploy; then
  echo "[user-data] first deploy complete"
else
  # Not fatal to the boot: the usual cause is a secret that has no value yet.
  # The box stays up and reachable over SSM; put the values and deploy.
  echo "[user-data] the first deploy did not finish (see above)."
  echo "[user-data] put the secret values (README, First deploy), then deploy through the module's deploy document"
fi
