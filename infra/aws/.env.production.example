# Vocion .env.production — single-EC2 deploy (Phase F).
#
# Copy to .env.production on the EC2, fill in every (set me) value.
# Never commit. Operator-managed; the bootstrap script reads from this
# path. The Dockerfile does not bake any secrets; everything below is
# injected at container start.

# ----- DNS -----
VOCION_HOSTNAME=app.vocion.ai          # (set me) — Caddy provisions TLS for this hostname
# Public base URL — used by sitemap.xml, robots.txt, and any
# server-rendered absolute link. MUST include the scheme.
NEXT_PUBLIC_APP_URL=https://app.vocion.ai

# ----- Database -----
# Default routes to the in-network postgres service started by the
# repo-root docker-compose.yml. Replace with your RDS endpoint to
# split DB onto a managed service.
DATABASE_URL=postgres://postgres:postgres@postgres:5432/vocion

# ----- Clerk (auth) -----
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_   # (set me)
CLERK_SECRET_KEY=sk_live_                    # (set me)

# ----- LLM providers -----
ANTHROPIC_API_KEY=sk-ant-                    # (set me)
OPENAI_API_KEY=sk-                           # (set me — only if any agent uses OpenAI)

# Optional per-role model overrides. Defaults:
#   main       = claude-sonnet-4-6
#   classifier = claude-haiku-4-5-20251001
# VOCION_LLM_MODEL_MAIN=claude-opus-4-7
# VOCION_LLM_PROVIDER=anthropic

# Opt into the deepagents runtime via the new /rpc/agent/stream route.
VOCION_AGENT_RUNTIME=deepagents

# ----- Retrieval -----
# Native pgvector retrieval (no external dependency). The app's
# Postgres has the pgvector extension installed (see L.1). To opt out
# of the rerank pass or override the embedding model, set:
# VOCION_EMBEDDING_MODEL=text-embedding-3-small
# VOCION_RERANK_MODEL=claude-haiku-4-5-20251001

# ----- Langfuse (observability) -----
# Pick ONE of the two paths below. Full walkthrough of both, including
# what each costs to run: docs/deployment/observability.md.
#
# LANGFUSE_ENABLED controls tracing outright:
#   false  — no tracing. Nothing else in this section is needed.
#   true   — tracing on; the keys and base URL are required and the app
#            refuses to boot without them.
#   unset  — on when both keys are present, off when they are not.
# Set it explicitly, so "no traces" is always a decision someone made.
LANGFUSE_ENABLED=true

# --- Path A: Langfuse Cloud (managed) ---
# Three values and you are done. Create the project at
# cloud.langfuse.com, then copy its keys here and delete Path B.
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-                    # (set me)
LANGFUSE_SECRET_KEY=sk-lf-                    # (set me)
LANGFUSE_PROJECT_ID=                          # (set me) the project's id, for deep-links

# --- Path B: self-hosted on this box ---
# Adds six containers (langfuse-web, langfuse-worker, its own Postgres,
# ClickHouse, Redis, and object storage) to an instance already running
# the app, the feedback worker, Caddy, the application Postgres, Temporal
# and the OTel collector. ClickHouse wants real memory of its own, so
# size the instance for it.
#
# With this path, LANGFUSE_BASE_URL becomes the internal compose
# hostname, because that is how the app reaches it:
# LANGFUSE_BASE_URL=http://langfuse-web:3000
#
# The public hostname Caddy serves it on. Also Langfuse's own
# NEXTAUTH_URL, so a wrong value breaks its sign-in specifically.
# LANGFUSE_SITE_ADDRESS is what the Caddyfile binds; leave it unset on
# Path A and that site block never comes up.
# LANGFUSE_SITE_ADDRESS=traces.your-domain.com
# LANGFUSE_PUBLIC_URL=https://traces.your-domain.com
#
# Secrets. Generate fresh per deployment — never reuse the values in
# infra/docker-compose.platform.yml, which are committed to this repo:
#   openssl rand -base64 32   → NEXTAUTH_SECRET, SALT, the passwords
#   openssl rand -hex 32      → ENCRYPTION_KEY
# ENCRYPTION_KEY is what Langfuse encrypts stored LLM API keys with:
# losing it loses those keys, changing it makes them unreadable.
# LANGFUSE_NEXTAUTH_SECRET=
# LANGFUSE_SALT=
# LANGFUSE_ENCRYPTION_KEY=
# LANGFUSE_POSTGRES_PASSWORD=
# LANGFUSE_CLICKHOUSE_PASSWORD=
# LANGFUSE_REDIS_PASSWORD=
#
# Object storage for event and media payloads. A real S3 bucket, not the
# MinIO container the laptop stack uses. Leave the key pair blank to use
# the instance role instead of static credentials.
# LANGFUSE_S3_BUCKET=
# LANGFUSE_S3_REGION=us-east-1
# LANGFUSE_S3_ACCESS_KEY_ID=
# LANGFUSE_S3_SECRET_ACCESS_KEY=
#
# First boot only: creates the admin login, the org, the project, and
# the API keys. After the database exists these are ignored, so the
# first boot is what sets the password — do not leave the demo values.
# The PROJECT keys must match LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY
# above, or the app authenticates against a project that does not exist
# and traces stop landing.
# LANGFUSE_INIT_USER_EMAIL=
# LANGFUSE_INIT_USER_PASSWORD=
# LANGFUSE_INIT_USER_NAME=Operator
# LANGFUSE_INIT_ORG_ID=
# LANGFUSE_INIT_ORG_NAME=
# LANGFUSE_INIT_PROJECT_NAME=

# --- Both paths ---
# Browser-reachable mirrors for the in-app "Open in Langfuse" links.
# Required when self-hosting, because LANGFUSE_BASE_URL is then an
# internal hostname no browser can resolve. On Cloud, leave them unset
# and the app falls back to LANGFUSE_BASE_URL.
# NEXT_PUBLIC_LANGFUSE_BASE_URL=https://traces.your-domain.com
# NEXT_PUBLIC_LANGFUSE_PROJECT_ID=

# ----- Feedback worker (opt-in) -----
# Set to 1 to start the worker container. Anti-loop filter — leave
# blank if you have no bot identity yet.
ENABLE_FEEDBACK_WORKER=1
VOCION_BOT_EMAIL=

# ----- Sentry (optional) -----
# Leave NEXT_PUBLIC_SENTRY_DISABLED=1 to skip Sentry source-map upload.
NEXT_PUBLIC_SENTRY_DISABLED=1
# SENTRY_DSN=
# SENTRY_ORGANIZATION=
# SENTRY_PROJECT=

# ----- Stripe (optional) -----
# Leave unset to disable billing flows.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
