# Vocion .env.production — single-EC2 deploy (Phase F).
#
# Copy to .env.production on the EC2, fill in every (set me) value.
# Never commit. Operator-managed; the bootstrap script reads from this
# path. The Dockerfile does not bake any secrets; everything below is
# injected at container start.

# ----- DNS -----
VOCION_HOSTNAME=app.vocion.ai          # (set me) — Caddy provisions TLS for this hostname
# Public base URL — used by sitemap.xml, robots.txt, and any
# server-rendered absolute link. MUST include the scheme.
NEXT_PUBLIC_APP_URL=https://app.vocion.ai

# ----- Database -----
# Default routes to the in-network postgres service started by the
# repo-root docker-compose.yml. Replace with your RDS endpoint to
# split DB onto a managed service.
DATABASE_URL=postgres://postgres:postgres@postgres:5432/vocion

# ----- Clerk (auth) -----
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_   # (set me)
CLERK_SECRET_KEY=sk_live_                    # (set me)

# ----- LLM providers -----
ANTHROPIC_API_KEY=sk-ant-                    # (set me)
OPENAI_API_KEY=sk-                           # (set me — only if any agent uses OpenAI)

# Optional per-role model overrides. Defaults:
#   main       = claude-sonnet-4-6
#   classifier = claude-haiku-4-5-20251001
# VOCION_LLM_MODEL_MAIN=claude-opus-4-7
# VOCION_LLM_PROVIDER=anthropic

# Opt into the deepagents runtime via the new /rpc/agent/stream route.
VOCION_AGENT_RUNTIME=deepagents

# ----- Retrieval -----
# Native pgvector retrieval (no external dependency). The app's
# Postgres has the pgvector extension installed (see L.1). To opt out
# of the rerank pass or override the embedding model, set:
# VOCION_EMBEDDING_MODEL=text-embedding-3-small
# VOCION_RERANK_MODEL=claude-haiku-4-5-20251001

# ----- Langfuse (observability) -----
# Langfuse is where traces, prompts and per-client model spend land.
# Without it, "why did the agent answer that" and "what is this client
# costing us" have no answer. Full walkthrough, and what each option
# costs to run: docs/deployment/observability.md.
#
# Vocion SELF-HOSTS it by default — the containers come up unless you
# say otherwise, so a new deployment has observability from day one
# rather than as a later procurement step. The values under "self-hosted"
# below are therefore REQUIRED, and bootstrap.sh refuses to deploy until
# they are set or until you opt out.

# Tracing on/off, independent of where Langfuse lives:
#   true   — on; the keys and base URL are required and the app refuses
#            to boot without them.
#   false  — off. Nothing else in this section is needed, and the
#            dashboard says trace search is unavailable.
#   unset  — on when both keys are present, off when they are not.
# Set it explicitly, so "no traces" is always a decision someone made.
LANGFUSE_ENABLED=true

# The project's API keys. Needed on every path. When self-hosting these
# are what the first boot seeds the project with; on Cloud they are what
# you copy out of the Langfuse UI.
LANGFUSE_PUBLIC_KEY=pk-lf-                    # (set me)
LANGFUSE_SECRET_KEY=sk-lf-                    # (set me)
LANGFUSE_PROJECT_ID=                          # (set me) used for deep-links

# How many days of traces to keep. Defaults to 365 — one year — when
# unset. An explicit 0 keeps everything forever; minimum otherwise is 3.
#
# Enforced by Vocion, not by Langfuse: Langfuse has no such variable,
# and its own project-level retention is an Enterprise feature when
# self-hosted. A daily Temporal job deletes traces past this age through
# the public API, so it needs the Temporal worker running
# (ENABLE_TEMPORAL_WORKER=1) — without that, nothing is deleted whatever
# this says.
#
# A year covers year-over-year cost comparisons and any realistic "what
# did this agent do in March" question. Shorten it for a chatty
# deployment; ClickHouse growth tracks LLM call volume and shares a disk
# with the application database.
LANGFUSE_RETENTION_DAYS=365

# ===== Self-hosted on this box (the default) =====
# Six containers — langfuse-web, langfuse-worker, its own Postgres,
# ClickHouse, Redis and object storage — on an instance already running
# the app, the feedback worker, Caddy, the application Postgres,
# Temporal and the OTel collector. ClickHouse wants real memory of its
# own, so size the instance for it.

# How the APP reaches Langfuse: the internal compose hostname.
LANGFUSE_BASE_URL=http://langfuse-web:3000

# How a PERSON reaches it. Caddy binds LANGFUSE_SITE_ADDRESS and serves
# TLS for it; LANGFUSE_PUBLIC_URL is the same host as a URL, and becomes
# Langfuse's own NEXTAUTH_URL, so a wrong value breaks its sign-in
# specifically rather than the whole app.
LANGFUSE_SITE_ADDRESS=traces.your-domain.com          # (set me)
LANGFUSE_PUBLIC_URL=https://traces.your-domain.com    # (set me)
# The browser-facing mirrors the app uses for its "Open in Langfuse"
# links. Same host as above; required because LANGFUSE_BASE_URL is
# internal and no browser can resolve it.
NEXT_PUBLIC_LANGFUSE_BASE_URL=https://traces.your-domain.com   # (set me)
NEXT_PUBLIC_LANGFUSE_PROJECT_ID=                               # (set me)

# Secrets. Generate fresh per deployment — never reuse the values in
# infra/docker-compose.platform.yml, which are committed to this repo:
#   openssl rand -base64 32   → NEXTAUTH_SECRET, SALT, the passwords
#   openssl rand -hex 32      → ENCRYPTION_KEY
# ENCRYPTION_KEY is what Langfuse encrypts stored LLM API keys with:
# losing it loses those keys, changing it makes them unreadable.
LANGFUSE_NEXTAUTH_SECRET=                     # (set me)
LANGFUSE_SALT=                                # (set me)
LANGFUSE_ENCRYPTION_KEY=                      # (set me)
LANGFUSE_POSTGRES_PASSWORD=                   # (set me)
LANGFUSE_CLICKHOUSE_PASSWORD=                 # (set me)
LANGFUSE_REDIS_PASSWORD=                      # (set me)

# How much memory the trace database may use. Both are optional; the
# values below are the defaults that ship, shown commented out.
# ClickHouse would otherwise take about 90% of the machine's RAM, and it
# shares this box with the app, Postgres, Temporal, Redis and Caddy.
#
# The two numbers do different jobs, and the second must stay LOWER than
# the first:
#   LANGFUSE_CLICKHOUSE_MEMORY_LIMIT             kernel-enforced. Cross
#                                                it and ClickHouse gets
#                                                killed and restarts,
#                                                losing trace ingestion
#                                                until it comes back.
#   LANGFUSE_CLICKHOUSE_MAX_SERVER_MEMORY_BYTES  ClickHouse-enforced, in
#                                                bytes. Cross it and one
#                                                expensive query fails
#                                                while the server stays
#                                                up. 3221225472 = 3 GB.
#
# Raise them together on a bigger instance, keeping the second lower.
# See docs/deployment/observability.md.
# LANGFUSE_CLICKHOUSE_MEMORY_LIMIT=4g
# LANGFUSE_CLICKHOUSE_MAX_SERVER_MEMORY_BYTES=3221225472

# Object storage for event and media payloads. A real S3 bucket, not the
# MinIO container the laptop stack uses. Leave the key pair blank to use
# the instance role instead of static credentials.
LANGFUSE_S3_BUCKET=                           # (set me)
LANGFUSE_S3_REGION=us-east-1
LANGFUSE_S3_ACCESS_KEY_ID=
LANGFUSE_S3_SECRET_ACCESS_KEY=

# First boot only: creates the admin login, the org and the project.
# After the database exists these are ignored, so the first boot is what
# sets the admin password — do not leave a placeholder.
LANGFUSE_INIT_USER_EMAIL=                     # (set me)
LANGFUSE_INIT_USER_PASSWORD=                  # (set me)
LANGFUSE_INIT_USER_NAME=Operator
LANGFUSE_INIT_ORG_ID=                         # (set me)
LANGFUSE_INIT_ORG_NAME=                       # (set me)
LANGFUSE_INIT_PROJECT_NAME=                   # (set me)

# ===== Langfuse Cloud instead =====
# To use managed Langfuse: uncomment these three, blank out or delete
# every "self-hosted" value above, and point LANGFUSE_BASE_URL at Cloud.
# The six containers then stay at zero replicas.
#
# LANGFUSE_SELF_HOSTED_REPLICAS=0
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# (then leave LANGFUSE_SITE_ADDRESS and the NEXT_PUBLIC_ mirrors unset —
#  the Caddy site block never binds, and deep links fall back to
#  LANGFUSE_BASE_URL, which a browser can reach on Cloud.)

# ----- Feedback worker (opt-in) -----
# Set to 1 to start the worker container. Anti-loop filter — leave
# blank if you have no bot identity yet.
ENABLE_FEEDBACK_WORKER=1
VOCION_BOT_EMAIL=

# ----- Sentry (optional) -----
# Leave NEXT_PUBLIC_SENTRY_DISABLED=1 to skip Sentry source-map upload.
NEXT_PUBLIC_SENTRY_DISABLED=1
# SENTRY_DSN=
# SENTRY_ORGANIZATION=
# SENTRY_PROJECT=

# ----- Stripe (optional) -----
# Leave unset to disable billing flows.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
