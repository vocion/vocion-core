# The on-box runner's own environment (docker-compose.prod.yml `vocion-runner`). Copy to
# runner.env beside .env.production. Everything here is visible to the engineer's tests, so it
# carries only what the runner needs: never the app's DATABASE_URL or AUTH_SECRET.
# (set me) the same value as the app's VOCION_RUNNER_TOKEN, or on a multi-tenant host one account's
# runner token (vcn_runner_…). The runner claims with it in a process of its own and builds without
# it (docs/guides/runner.md "Multi-tenant deployments").
VOCION_RUNNER_TOKEN=
ANTHROPIC_API_KEY=                            # (set me) the model key the engineer runs on
# A fallback push token. A run's own repository credential comes from Vocion at claim.
# GITHUB_TOKEN=
# Where screenshots are stored; unset, they go into Vocion inline.
# QA_EVIDENCE_BUCKET=
# QA_EVIDENCE_REGION=
# PRESIGN_ACCESS_KEY_ID=
# PRESIGN_SECRET_ACCESS_KEY=
# MAX_BUDGET_USD=12
# WALL_CLOCK_MINUTES=45
