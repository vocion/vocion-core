{
  "name": "@vocion/agent-runtime",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Vocion BYOA agent runtime — the deepagents loop as a standalone artifact (/invocations + /ping), hostable on AWS Bedrock AgentCore Runtime or any container/host.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "node esbuild.config.mjs",
    "check:types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@arizeai/openinference-core": "^2.7.1",
    "@arizeai/openinference-instrumentation-langchain": "^4.1.1",
    "@aws-sdk/client-bedrock-agentcore": "^3.1137.0",
    "@langchain/anthropic": "^1.5.11",
    "@langchain/aws": "^1.4.5",
    "@langchain/core": "^1.1.45",
    "@langchain/langgraph": "^1.4.17",
    "@opentelemetry/api": "^1.9.1",
    "deepagents": "^1.14.0",
    "langchain": "^1.4.0",
    "langfuse": "^3.39.2"
  },
  "devDependencies": {
    "@opentelemetry/context-async-hooks": "^2.11.0",
    "esbuild": "~0.28.2",
    "tsx": "^4.23.15",
    "vitest": "^4.1.11"
  }
}
