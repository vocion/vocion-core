diff --git a/test/dates.test.mjs b/test/dates.test.mjs
new file mode 100644
index 0000000..abaf655
--- /dev/null
+++ b/test/dates.test.mjs
@@ -0,0 +1,25 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { createApp, request } from './helpers.mjs';
+
+async function dates(tz) {
+  const saved = process.env.TZ;
+  process.env.TZ = tz;
+  try {
+    const app = createApp();
+    const library = (await request(app, { path: '/', user: 'u_owner' })).body;
+    const audit = (await request(app, { path: '/api/libraries/lib_team/audit.csv', user: 'u_owner' })).body;
+    app.clock.set('2026-10-03T23:30:00.000Z');
+    const keys = app.runJob('reminders').map(m => m.key);
+    return { library, audit, keys };
+  } finally {
+    process.env.TZ = saved;
+  }
+}
+
+test('dates read the same whatever the server time zone', async () => {
+  const utc = await dates('UTC');
+  assert.deepEqual(await dates('Pacific/Auckland'), utc);
+  assert.deepEqual(await dates('America/Los_Angeles'), utc);
+  assert.ok(utc.keys.includes('reminder:l2:2026-10-03'));
+});
