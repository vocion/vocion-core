+/** Trimmed, 1 to 24 characters, at most 10, case-insensitive duplicates dropped (first spelling kept). */
+export function normaliseTags(input) {
+  if (!Array.isArray(input)) {
+    return { error: 'invalid_tag' };
+  }
+  const out = [];
+  for (const raw of input) {
+    const tag = typeof raw === 'string' ? raw.trim() : '';
+    if (!tag || tag.length > 24) {
+      return { error: 'invalid_tag' };
+    }
+    if (!out.some(t => t.toLowerCase() === tag.toLowerCase())) {
+      out.push(tag);
+    }
+  }
+  return out.length > 10 ? { error: 'too_many_tags' } : { tags: out };
+}
+
