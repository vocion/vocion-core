index 0000000..5fb5ee5
--- /dev/null
+++ b/test/tags.test.mjs
@@ -0,0 +1,11 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { handle } from '../src/api.mjs';
+import { createStore, normaliseTags } from '../src/store.mjs';
+
+test('tags are normalised and filter the library', () => {
+  assert.deepEqual(normaliseTags([' Board', 'board', 'Q3']), { tags: ['Board', 'Q3'] });
+  const store = createStore();
+  handle(store, { method: 'PUT', path: '/api/documents/d1/tags', body: { tags: ['Board'] }, userId: 'u_owner' });
+  assert.deepEqual(handle(store, { path: '/api/documents', query: { tag: 'board' }, userId: 'u_teammate' }).body.documents.map(d => d.id), ['d1']);
+});
