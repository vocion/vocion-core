+      if (userId && access.canSee(userId, doc)) {
+        return { state: 'ok', link, doc, preview: true };
+      }
+      repos.views.record({ linkId: link.id, docId: doc.id, viewerEmail: link.recipientEmail, userId, at: clock.now(), userAgent });
