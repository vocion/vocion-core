+
+test('a library member previewing a link is not an open and does not stop reminders', async () => {
+  const app = createApp();
+  await request(app, { path: '/l/l2', user: 'u_owner' });
+  assert.equal(app.repos.views.forLink('l2').length, 0);
+  app.clock.set('2026-10-03T13:00:00.000Z');
+  assert.ok(app.runJob('reminders').some(m => m.to === 'board@kestrel.example'));
+});
