diff --git a/src/services/erasure.mjs b/src/services/erasure.mjs
new file mode 100644
index 0000000..a000ae7
--- /dev/null
+++ b/src/services/erasure.mjs
@@ -0,0 +1,61 @@
+import { sha256 } from '../lib/crypto.mjs';
+
+/**
+ * Erasing a person on request (docs/policy.md). Their documents, the links on them and the links
+ * they made, the views recorded against them and their memberships are removed. The audit log is
+ * kept for 7 years and never deleted, so their entries stay, but keep no more about them than they
+ * need: their id becomes one stable pseudonym, and their email and name are blanked wherever an
+ * entry carries them.
+ */
+export function createErasure({ repos, events, clock }) {
+  const scrub = (value, secrets) => {
+    if (typeof value === 'string') {
+      return secrets.some(s => value.toLowerCase() === s.toLowerCase()) ? '[erased]' : value;
+    }
+    if (Array.isArray(value)) {
+      return value.map(v => scrub(v, secrets));
+    }
+    if (value && typeof value === 'object') {
+      return Object.fromEntries(Object.entries(value).map(([k, v]) => [k, scrub(v, secrets)]));
+    }
+    return value;
+  };
+
+  return {
+    erase(userId) {
+      const user = repos.users.find(userId);
+      if (!user) {
+        return null;
+      }
+      const pseudonym = `erased_${sha256(`${user.id}:${user.email}`).slice(0, 12)}`;
+      const email = user.email.toLowerCase();
+
+      const docs = repos.documents.all().filter(d => d.ownerId === userId);
+      const docIds = new Set(docs.map(d => d.id));
+      const links = repos.links.all().filter(l => docIds.has(l.docId) || l.createdBy === userId);
+      const linkIds = new Set(links.map(l => l.id));
+      repos.views.removeWhere(v => docIds.has(v.docId) || linkIds.has(v.linkId) || v.userId === userId || String(v.viewerEmail).toLowerCase() === email);
+      for (const link of links) {
+        repos.links.remove(link.id);
+      }
+      for (const doc of docs) {
+        repos.documents.remove(doc.id);
+        events.emit('document.deleted', { doc });
+      }
+      repos.libraries.removeMemberships(userId);
+
+      const secrets = [user.id, user.email, user.name];
+      for (const entry of repos.audit.all()) {
+        const actorId = entry.actorId === userId ? pseudonym : entry.actorId;
+        const detail = scrub(entry.detail, secrets);
+        const targetId = entry.targetId === userId ? pseudonym : entry.targetId;
+        if (actorId !== entry.actorId || targetId !== entry.targetId || JSON.stringify(detail) !== JSON.stringify(entry.detail)) {
+          repos.audit.rewrite(entry.id, { actorId, targetId, detail });
+        }
+      }
+      repos.users.remove(userId);
+      repos.audit.write({ at: clock.now(), actorId: pseudonym, action: 'user.erased', targetId: pseudonym, detail: { documents: docs.length, links: links.length } });
+      return pseudonym;
+    },
+  };
+}
diff --git a/test/erasure.test.mjs b/test/erasure.test.mjs
new file mode 100644
index 0000000..aa3526b
--- /dev/null
+++ b/test/erasure.test.mjs
@@ -0,0 +1,15 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { createApp, request } from './helpers.mjs';
+
+test('erasure removes a person\'s data but keeps the audit log, pseudonymized', async () => {
+  const app = createApp();
+  await request(app, { method: 'POST', path: '/api/documents/d6/links', user: 'u_other', body: { recipientEmail: 'x@y.example' } });
+  const entries = app.repos.audit.all().length;
+  assert.equal((await request(app, { method: 'DELETE', path: '/api/me', user: 'u_other' })).status, 204);
+  assert.equal(app.repos.users.find('u_other'), null);
+  assert.equal(app.repos.documents.find('d6'), null);
+  const audit = app.repos.audit.all();
+  assert.equal(audit.length, entries + 1);
+  assert.doesNotMatch(JSON.stringify(audit), /u_other|ana@acme\.example/);
+});
