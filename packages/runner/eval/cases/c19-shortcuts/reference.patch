+++ b/src/web/shortcuts.mjs
@@ -0,0 +1,36 @@
+// The library's keyboard shortcuts, as a pure function so the page script and the tests share it.
+
+const TYPING = new Set(['INPUT', 'TEXTAREA', 'SELECT']);
+const ROW_ACTIONS = { Enter: 'open', s: 'star', a: 'archive', c: 'copy-link' };
+
+export const SHORTCUTS = [
+  ['Up / k', 'Move up'],
+  ['Down / j', 'Move down'],
+  ['Enter', 'Open'],
+  ['s', 'Star'],
+  ['a', 'Archive'],
+  ['c', 'Copy link'],
+  ['?', 'Show shortcuts'],
+];
+
+export function libraryKey(state, event) {
+  if (TYPING.has(String(event?.target?.tagName || '').toUpperCase())) {
+    return null;
+  }
+  const { ids, highlight } = state;
+  const last = ids.length - 1;
+  const key = event.key;
+  if (key === 'ArrowDown' || key === 'j') {
+    return { highlight: Math.min(last, highlight + 1), action: null };
+  }
+  if (key === 'ArrowUp' || key === 'k') {
+    return { highlight: Math.max(0, highlight - 1), action: null };
+  }
+  if (key === '?') {
+    return { highlight, action: { type: 'help' } };
+  }
+  if (ROW_ACTIONS[key] && highlight >= 0 && highlight <= last) {
+    return { highlight, action: { type: ROW_ACTIONS[key], id: ids[highlight] } };
+  }
+  return { highlight, action: null };
+}
