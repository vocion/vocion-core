@@ -0,0 +1,10 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { libraryKey } from '../src/web/shortcuts.mjs';
+
+test('Down moves the highlight and Enter opens; nothing fires while typing', () => {
+  const ids = ['d1', 'd2'];
+  assert.equal(libraryKey({ ids, highlight: -1 }, { key: 'ArrowDown', target: { tagName: 'BODY' } }).highlight, 0);
+  assert.deepEqual(libraryKey({ ids, highlight: 1 }, { key: 'Enter', target: { tagName: 'BODY' } }).action, { type: 'open', id: 'd2' });
+  assert.equal(libraryKey({ ids, highlight: 0 }, { key: 's', target: { tagName: 'INPUT' } }), null);
+});
