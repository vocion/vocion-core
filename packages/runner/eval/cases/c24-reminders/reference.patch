diff --git a/test/reminders.test.mjs b/test/reminders.test.mjs
new file mode 100644
index 0000000..e07bc8e
--- /dev/null
+++ b/test/reminders.test.mjs
@@ -0,0 +1,11 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { handle } from '../src/api.mjs';
+import { createStore } from '../src/store.mjs';
+
+test('a reminder goes to a recipient who has not opened, once per 72 hours', () => {
+  const store = createStore();
+  const remind = () => handle(store, { method: 'POST', path: '/api/documents/d4/reminders', userId: 'u_owner' }).body;
+  assert.deepEqual(remind().queued, ['legal@contoso.example']);
+  assert.deepEqual(remind().skipped, ['legal@contoso.example']);
+});
