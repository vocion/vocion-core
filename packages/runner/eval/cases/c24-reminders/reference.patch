+    /** Queues a reminder per link nobody but the owner opened; one per link per 72 hours. */
+    remind(doc) {
+      db.outbox ||= [];
+      const queued = [];
+      const skipped = [];
+      for (const link of db.links.filter(l => l.docId === doc.id)) {
+        if (db.views.some(v => v.linkId === link.id && v.viewerId !== doc.ownerId)) {
+          continue;
+        }
+        const recent = db.outbox.some(m => m.linkId === link.id && new Date(db.now) - new Date(m.at) < REMIND_EVERY_MS);
+        if (recent) {
+          skipped.push(link.recipientEmail);
+          continue;
+        }
+        db.outbox.push({ to: link.recipientEmail, linkId: link.id, docId: doc.id, at: db.now });
+        queued.push(link.recipientEmail);
+      }
+      return { queued, skipped };
