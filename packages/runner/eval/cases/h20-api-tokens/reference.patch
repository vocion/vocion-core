new file mode 100644
index 0000000..709f67d
--- /dev/null
+++ b/src/http/routes/tokens.mjs
@@ -0,0 +1,18 @@
+const view = t => ({ id: t.id, name: t.name, scope: t.scope, createdAt: t.createdAt, lastUsedAt: t.lastUsedAt, revokedAt: t.revokedAt });
+
+// Managing tokens takes a signed-in session: a token cannot mint or revoke tokens.
+const SESSION = { session: true };
+
+export const tokenRoutes = [
+  ['GET', '/api/tokens', ({ user, services }) => ({ json: { tokens: services.tokens.list(user.id).map(view) } }), SESSION],
+
+  ['POST', '/api/tokens', ({ user, body, services }) => {
+    const { token, secret } = services.tokens.create(user.id, body);
+    return { status: 201, json: { token: view(token), secret } };
+  }, SESSION],
+
+  ['DELETE', '/api/tokens/:id', ({ user, params, services }) => {
+    services.tokens.revoke(user.id, params.id);
+    return { status: 204, json: {} };
+  }, SESSION],
+];
