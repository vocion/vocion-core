--- /dev/null
+++ b/src/repos/tokens.mjs
@@ -0,0 +1,9 @@
+export function tokensRepo(db, ids) {
+  return {
+    find: id => db.find('api_tokens', id),
+    byHash: hash => db.where('api_tokens', t => t.hash === hash)[0] || null,
+    forUser: userId => db.where('api_tokens', t => t.userId === userId),
+    create: token => db.insert('api_tokens', { id: ids.next('tok'), ...token }),
+    update: (id, patch) => db.update('api_tokens', id, patch),
+  };
+}
diff --git a/src/services/tokens.mjs b/src/services/tokens.mjs
new file mode 100644
index 0000000..d0ba9fa
--- /dev/null
+++ b/src/services/tokens.mjs
@@ -0,0 +1,49 @@
+import { TOKEN_NAME_MAX } from '../config.mjs';
+import { randomToken, sha256 } from '../lib/crypto.mjs';
+import { badRequest, notFound, requireString } from '../lib/validate.mjs';
+
+export const SCOPES = ['read', 'write'];
+const PREFIX = 'dr_';
+
+/**
+ * Personal API tokens: `Authorization: Bearer <secret>` acts as the token's owner on /api routes.
+ * A `read` token may only read (GET). The secret is shown once, at creation; only its SHA-256 is
+ * stored, so a database leak does not leak working tokens.
+ */
+export function createTokens({ repos, clock }) {
+  const audit = (actorId, action, targetId, detail = {}) => repos.audit.write({ at: clock.now(), actorId, action, targetId, detail });
+  return {
+    create(userId, { name, scope } = {}) {
+      const label = requireString(name, 'invalid_name', { max: TOKEN_NAME_MAX });
+      if (!SCOPES.includes(scope)) {
+        throw badRequest('invalid_scope');
+      }
+      const secret = `${PREFIX}${randomToken(24)}`;
+      const token = repos.tokens.create({ userId, name: label, scope, hash: sha256(secret), createdAt: clock.now() });
+      audit(userId, 'token.created', token.id, { name: label, scope });
+      return { token, secret };
+    },
+    list: userId => repos.tokens.forUser(userId),
+    revoke(userId, id) {
+      const token = repos.tokens.find(id);
+      if (!token || token.userId !== userId) {
+        throw notFound();
+      }
+      if (!token.revokedAt) {
+        repos.tokens.update(token.id, { revokedAt: clock.now() });
+        audit(userId, 'token.revoked', token.id, { name: token.name });
+      }
+    },
+    /** The live token for a secret (its last use recorded), or null. */
+    authenticate(secret) {
+      if (typeof secret !== 'string' || !secret.startsWith(PREFIX)) {
+        return null;
+      }
+      const token = repos.tokens.byHash(sha256(secret));
+      if (!token || token.revokedAt) {
+        return null;
+      }
+      return repos.tokens.update(token.id, { lastUsedAt: clock.now() });
+    },
+  };
+}
diff --git a/test/tokens.test.mjs b/test/tokens.test.mjs
new file mode 100644
index 0000000..a15812d
--- /dev/null
+++ b/test/tokens.test.mjs
@@ -0,0 +1,14 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { createApp, request } from './helpers.mjs';
+
+test('API tokens authenticate, respect their scope and can be revoked', async () => {
+  const app = createApp();
+  const r = await request(app, { method: 'POST', path: '/api/tokens', user: 'u_owner', body: { name: 'sync', scope: 'read' } });
+  const auth = { authorization: `Bearer ${r.body.secret}` };
+  assert.equal((await request(app, { path: '/api/me', headers: auth })).body.user.id, 'u_owner');
+  assert.equal((await request(app, { method: 'PATCH', path: '/api/documents/d1', headers: auth, body: { title: 'x' } })).body.error, 'insufficient_scope');
+  assert.ok(!JSON.stringify(app.db.all('api_tokens')).includes(r.body.secret));
+  await request(app, { method: 'DELETE', path: `/api/tokens/${r.body.token.id}`, user: 'u_owner' });
+  assert.equal((await request(app, { path: '/api/me', headers: auth })).status, 401);
+});
