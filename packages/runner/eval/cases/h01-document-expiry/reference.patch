diff --git a/test/expiry.test.mjs b/test/expiry.test.mjs
new file mode 100644
index 0000000..ac49fa7
--- /dev/null
+++ b/test/expiry.test.mjs
@@ -0,0 +1,23 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { createApp, request } from './helpers.mjs';
+
+const patch = (app, id, body, user = 'u_owner') => request(app, { method: 'PATCH', path: `/api/documents/${id}`, user, body });
+
+test('expiry is set by the uploader or a library owner, and must be in the future', async () => {
+  const app = createApp();
+  assert.equal((await patch(app, 'd1', { expiresAt: '2026-10-10T00:00:00.000Z' })).status, 200);
+  assert.equal((await patch(app, 'd1', { expiresAt: '2026-10-10T00:00:00.000Z' }, 'u_teammate')).status, 403);
+  assert.equal((await patch(app, 'd1', { expiresAt: '2026-01-01T00:00:00.000Z' })).body.error, 'invalid_expiry');
+});
+
+test('an expired document is hidden, its links answer 410, and the job removes them after 30 days', async () => {
+  const app = createApp();
+  await patch(app, 'd1', { expiresAt: '2026-10-02T00:00:00.000Z' });
+  app.clock.set('2026-10-02T00:00:00.000Z');
+  assert.equal((await request(app, { path: '/l/l1' })).status, 410);
+  assert.ok(!(await request(app, { path: '/', user: 'u_owner' })).body.includes('data-id="d1"'));
+  app.clock.set('2026-11-01T00:00:00.000Z');
+  app.runJob('expiry');
+  assert.equal(app.repos.links.forDocument('d1').length, 0);
+});
