diff --git a/src/services/expiry.mjs b/src/services/expiry.mjs
new file mode 100644
index 0000000..5cf3404
--- /dev/null
+++ b/src/services/expiry.mjs
@@ -0,0 +1,26 @@
+import { EXPIRED_LINKS_KEPT_DAYS } from '../config.mjs';
+import { addDays } from '../lib/time.mjs';
+
+export const isExpired = (doc, now) => Boolean(doc?.expiresAt) && doc.expiresAt <= now;
+
+/** The hourly expiry job: a document expired for 30 days loses its links; it is audited once. */
+export function createExpiry({ repos, clock }) {
+  return {
+    run() {
+      const now = clock.now();
+      const done = [];
+      for (const doc of repos.documents.expiredBefore(addDays(now, -EXPIRED_LINKS_KEPT_DAYS))) {
+        const links = repos.links.forDocument(doc.id);
+        if (!links.length) {
+          continue;
+        }
+        for (const link of links) {
+          repos.links.remove(link.id);
+        }
+        repos.audit.write({ at: now, actorId: null, action: 'document.expired', targetId: doc.id, detail: { links: links.map(l => l.id) } });
+        done.push(doc.id);
+      }
+      return done;
+    },
+  };
+}
