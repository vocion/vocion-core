 import { seed } from './data.mjs';
 
+/** Every word of the search starts a word of the title, ignoring case; a blank search matches all. */
+function matches(title, q) {
+  const words = String(q || '').toLowerCase().split(/\s+/).filter(Boolean);
+  const titleWords = title.toLowerCase().split(/[^a-z0-9]+/).filter(Boolean);
+  return words.every(w => titleWords.some(t => t.startsWith(w)));
+}
+
 // The data in memory and the queries over it. `store.db` is the data itself.
