diff --git a/src/http/routes/admin.mjs b/src/http/routes/admin.mjs
index 1b733b7..1b615fa 100644
--- a/src/http/routes/admin.mjs
+++ b/src/http/routes/admin.mjs
@@ -1,5 +1,6 @@
 import { csvResponse } from '../../lib/csv.mjs';
 import { format } from '../../lib/legacyDate.mjs';
+import { isoMinute } from '../../lib/time.mjs';
 import { forbidden, notFound } from '../../lib/validate.mjs';
 
 export const adminRoutes = [
@@ -19,4 +20,18 @@ export const adminRoutes = [
     const rows = entries.map(a => [format(a.at, 'YYYY-MM-DD HH:mm'), repos.users.find(a.actorId)?.email || a.actorId, a.action, a.targetId, a.detail?.recipientEmail || '']);
     return csvResponse(`audit-${library.id}.csv`, ['When (UTC)', 'Who', 'Action', 'Target', 'Recipient'], rows);
   }],
+
+  // A document's opens, for the owners of its library (the same people as the audit log). Robots
+  // are left out, as on the activity page.
+  ['GET', '/api/documents/:id/activity.csv', ({ user, params, repos, services }) => {
+    const doc = services.access.visibleDocument(user.id, params.id);
+    if (repos.libraries.membership(doc.libraryId, user.id)?.role !== 'owner') {
+      throw forbidden();
+    }
+    const visits = services.analytics.linkActivity(doc.id)
+      .flatMap(a => a.visits.map(v => ({ ...v, recipientEmail: a.recipientEmail })))
+      .sort((a, b) => a.at.localeCompare(b.at));
+    const rows = visits.map(v => [isoMinute(v.at), v.recipientEmail, v.userAgent]);
+    return csvResponse(`activity-${doc.id}.csv`, ['When (UTC)', 'Recipient', 'Browser'], rows);
+  }],
 ];
