diff --git a/test/downloads.test.mjs b/test/downloads.test.mjs
new file mode 100644
index 0000000..46ad9f3
--- /dev/null
+++ b/test/downloads.test.mjs
@@ -0,0 +1,11 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { handle } from '../src/api.mjs';
+import { createStore } from '../src/store.mjs';
+
+test('a link with downloads off still opens but does not download', () => {
+  const store = createStore();
+  assert.equal(handle(store, { method: 'PATCH', path: '/api/documents/d1/links/l1', body: { allowDownload: false }, userId: 'u_owner' }).status, 200);
+  assert.equal(handle(store, { path: '/l/l1/download' }).status, 403);
+  assert.equal(handle(store, { path: '/l/l1' }).status, 200);
+});
