diff --git a/test/comments.test.mjs b/test/comments.test.mjs
new file mode 100644
index 0000000..f14d5ac
--- /dev/null
+++ b/test/comments.test.mjs
@@ -0,0 +1,21 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { createApp, request } from './helpers.mjs';
+
+const post = (app, body, user = 'u_owner') => request(app, { method: 'POST', path: '/api/documents/d1/comments', user, body: { body } });
+
+test('members comment; @mentioned members are notified, outsiders are not', async () => {
+  const app = createApp();
+  assert.equal((await post(app, 'See @tom@northwind.example and @ana@acme.example')).status, 201);
+  const sent = app.repos.outbox.all().filter(o => o.type === 'comment.mention');
+  assert.deepEqual(sent.map(o => o.to), ['tom@northwind.example']);
+  assert.equal((await post(app, 'x', 'u_other')).status, 404);
+  assert.equal((await post(app, '')).body.error, 'invalid_body');
+});
+
+test('comments are escaped on the document page', async () => {
+  const app = createApp();
+  await post(app, '<i>hi</i>');
+  const html = (await request(app, { path: '/documents/d1', user: 'u_owner' })).body;
+  assert.ok(html.includes('&lt;i&gt;hi&lt;/i&gt;'));
+});
