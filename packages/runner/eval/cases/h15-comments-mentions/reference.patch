diff --git a/src/services/comments.mjs b/src/services/comments.mjs
new file mode 100644
index 0000000..3fc3b9b
--- /dev/null
+++ b/src/services/comments.mjs
@@ -0,0 +1,41 @@
+import { COMMENT_MAX } from '../config.mjs';
+import { badRequest } from '../lib/validate.mjs';
+
+const MENTION = /@([^\s@]+@[^\s@]+\.[a-z]{2,})/gi;
+
+/** The distinct email addresses @mentioned in a comment, lower-cased, trailing punctuation dropped. */
+export function mentionedEmails(body) {
+  return [...new Set([...String(body).matchAll(MENTION)].map(m => m[1].toLowerCase().replace(/[.,;:!?)]+$/, '')))];
+}
+
+export function createComments({ repos, access, notifier, clock }) {
+  return {
+    add(userId, docId, body) {
+      const doc = access.visibleDocument(userId, docId);
+      const text = typeof body === 'string' ? body.trim() : '';
+      if (!text || text.length > COMMENT_MAX) {
+        throw badRequest('invalid_body');
+      }
+      const comment = repos.comments.create({ docId: doc.id, authorId: userId, body: text, createdAt: clock.now() });
+      const author = repos.users.find(userId);
+      // Only members of the library hear about it: a mention must not show the document to anyone else.
+      for (const email of mentionedEmails(text)) {
+        const user = repos.users.byEmail(email);
+        if (!user || user.id === userId || !access.canSee(user.id, doc)) {
+          continue;
+        }
+        notifier.send('comment.mention', {
+          to: user.email,
+          subject: `${author.name} mentioned you on "${doc.title}"`,
+          body: `${author.name} mentioned you in a comment on "${doc.title}":\n\n${text}\n\nOpen it: https://dataroom.northwind.example/documents/${doc.id}\n`,
+          key: `mention:${comment.id}:${user.id}`,
+        });
+      }
+      return comment;
+    },
+    list(userId, docId) {
+      const doc = access.visibleDocument(userId, docId);
+      return repos.comments.forDocument(doc.id);
+    },
+  };
+}
