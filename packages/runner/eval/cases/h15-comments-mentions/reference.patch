+export function commentsRepo(db, ids) {
+  return {
+    forDocument: docId => db.where('comments', c => c.docId === docId).sort((a, b) => a.createdAt.localeCompare(b.createdAt) || a.id.localeCompare(b.id)),
+    create: comment => db.insert('comments', { id: ids.next('cmt'), ...comment }),
+  };
+}
