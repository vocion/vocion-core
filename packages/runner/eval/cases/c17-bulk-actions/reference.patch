diff --git a/test/bulk.test.mjs b/test/bulk.test.mjs
new file mode 100644
index 0000000..fd662ef
--- /dev/null
+++ b/test/bulk.test.mjs
@@ -0,0 +1,12 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { handle } from '../src/api.mjs';
+import { createStore } from '../src/store.mjs';
+
+test('starring several at once can be undone', () => {
+  const store = createStore();
+  const r = handle(store, { method: 'POST', path: '/api/documents/bulk', body: { ids: ['d1', 'd3'], action: 'star' }, userId: 'u_owner' });
+  assert.deepEqual(r.body.undo, { action: 'unstar', ids: ['d1', 'd3'] });
+  handle(store, { method: 'POST', path: '/api/documents/bulk', body: r.body.undo, userId: 'u_owner' });
+  assert.equal(store.isStarred('u_owner', 'd1'), false);
+});
