+const UNDO = { star: 'unstar', unstar: 'star', archive: 'unarchive', unarchive: 'archive' };
+
+/** One action over several documents, each under its single-document rule. */
+function bulk(store, userId, { ids, action } = {}) {
+  if (!Array.isArray(ids) || !['star', 'unstar', 'archive', 'unarchive', 'copy-links'].includes(action)) {
+    return { status: 400, body: { error: 'invalid_bulk' } };
+  }
+  const results = [];
+  const changed = [];
+  const lines = [];
+  for (const id of ids) {
+    const doc = store.findDocument(id);
+    if (!store.canSee(userId, doc)) {
+      results.push({ id, ok: false, error: 'not_found' });
+      continue;
+    }
+    if (action === 'copy-links') {
+      lines.push(...store.linksFor(doc.id).map(l => `${doc.title}: /l/${l.id}`));
+      results.push({ id, ok: true });
+      continue;
+    }
+    if (action === 'star' || action === 'unstar') {
+      const want = action === 'star';
+      if (store.isStarred(userId, doc.id) !== want) {
+        store.setStar(userId, doc.id, want);
+        changed.push(id);
+      }
+      results.push({ id, ok: true });
+      continue;
+    }
+    const want = action === 'archive';
+    const was = Boolean(doc.archivedAt);
+    const r = store.setArchived(userId, doc, want);
+    if (r.error) {
+      results.push({ id, ok: false, error: r.error });
+      continue;
+    }
+    if (was !== want) {
+      changed.push(id);
+    }
+    results.push({ id, ok: true });
+  }
+  const undo = action !== 'copy-links' && changed.length ? { action: UNDO[action], ids: changed } : null;
+  return { status: 200, body: { results, undo, ...(action === 'copy-links' ? { text: lines.join('\n') } : {}) } };
+}
+
