+
+test('search over many documents returns the first 50 in title order', () => {
+  const app = createApp();
+  for (let i = 0; i < 120; i++) {
+    app.db.insert('documents', { id: `m${i}`, libraryId: 'lib_team', ownerId: 'u_owner', title: `Memo ${String(119 - i).padStart(3, '0')}`, mimeType: 'application/pdf', sizeBytes: 1, pageCount: 1, uploadedAt: '2026-09-01T00:00:00.000Z' });
+  }
+  const fresh = createApp({ db: app.db });
+  const ids = fresh.services.search.search('u_owner', 'memo');
+  assert.equal(ids.length, 50);
+  assert.equal(ids[0], 'm119');
+  assert.equal(ids[49], 'm70');
