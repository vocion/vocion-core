+
+test('five wrong passcodes in 10 minutes lock a link for 15 minutes; members are not asked', async () => {
+  const app = createApp();
+  await request(app, { method: 'PATCH', path: '/api/documents/d1/links/l2', user: 'u_owner', body: { passcode: '4321' } });
+  for (let i = 0; i < 4; i++) {
+    assert.equal((await request(app, { path: '/l/l2', query: { passcode: 'bad' } })).status, 401);
+  }
+  assert.equal((await request(app, { path: '/l/l2', query: { passcode: 'bad' } })).status, 429);
+  assert.equal((await request(app, { path: '/l/l2', query: { passcode: '4321' } })).status, 429);
+  app.clock.advanceMinutes(15);
+  assert.equal((await request(app, { path: '/l/l2', query: { passcode: '4321' } })).status, 200);
+  assert.equal((await request(app, { path: '/l/l2', user: 'u_owner' })).status, 200);
+});
