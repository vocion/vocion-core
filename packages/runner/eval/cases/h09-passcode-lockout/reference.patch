@@ -0,0 +1,9 @@
+// Wrong passcodes are counted per link, so a link can be locked after too many.
+export default {
+  version: 4,
+  name: 'passcode_lockout',
+  up(db) {
+    db.addColumn('links', 'failedAttempts', []);
+    db.addColumn('links', 'lockedUntil', null);
+  },
+};
