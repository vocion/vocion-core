+const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
+
+function limits(store, l) {
+  const out = [];
+  if (l.expiresAt) {
+    const d = new Date(l.expiresAt);
+    out.push(`Expires ${MONTHS[d.getUTCMonth()]} ${d.getUTCDate()}`);
