diff --git a/test/expiry.test.mjs b/test/expiry.test.mjs
new file mode 100644
index 0000000..a106c96
--- /dev/null
+++ b/test/expiry.test.mjs
@@ -0,0 +1,11 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { handle } from '../src/api.mjs';
+import { createStore } from '../src/store.mjs';
+
+test('a link stops at its open limit', () => {
+  const store = createStore();
+  assert.equal(handle(store, { method: 'PATCH', path: '/api/documents/d3/links/l3', body: { maxOpens: 2 }, userId: 'u_owner' }).status, 200);
+  assert.equal(handle(store, { path: '/l/l3' }).status, 200);
+  assert.equal(handle(store, { path: '/l/l3' }).status, 410);
+});
