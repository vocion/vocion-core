diff --git a/test/access.test.mjs b/test/access.test.mjs
new file mode 100644
index 0000000..5a44e48
--- /dev/null
+++ b/test/access.test.mjs
@@ -0,0 +1,18 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { createApp } from './helpers.mjs';
+
+test('access.can holds the rules: archive is the uploader\'s alone, delete also a library owner\'s', async () => {
+  const app = createApp();
+  const doc = app.repos.documents.find('d1');
+  const can = (u, a) => app.services.access.can(u, a, doc);
+  assert.equal(can('u_teammate', 'view'), true);
+  assert.equal(can('u_other', 'view'), false);
+  assert.equal(can('u_teammate', 'archive'), false);
+  assert.equal(can('u_owner', 'archive'), true);
+  assert.equal(can('u_teammate', 'delete'), false);
+  const tom = (await app.handle({ method: 'POST', path: '/api/documents', headers: { 'x-user': 'u_teammate' }, body: { libraryId: 'lib_team', title: 'T' } })).body.document;
+  const t = app.repos.documents.find(tom.id);
+  assert.equal(app.services.access.can('u_owner', 'archive', t), false);
+  assert.equal(app.services.access.can('u_owner', 'delete', t), true);
+});
