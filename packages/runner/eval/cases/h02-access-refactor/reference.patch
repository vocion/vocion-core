diff --git a/src/services/access.mjs b/src/services/access.mjs
index 31fc76f..60a2c7a 100644
--- a/src/services/access.mjs
+++ b/src/services/access.mjs
@@ -1,22 +1,77 @@
-import { notFound } from '../lib/validate.mjs';
+import { forbidden, notFound } from '../lib/validate.mjs';
+
+// Every access decision in one place. A document a person cannot see answers exactly like a
+// missing one (404); one they can see but may not act on answers 403.
+//
+//   view, rename, share   any member of the document's library
+//   archive               only the person who uploaded it (not even a library owner)
+//   delete                the uploader or an owner of the library
+const RULES = {
+  view: () => true,
+  rename: () => true,
+  share: () => true,
+  archive: ({ userId, doc }) => doc.ownerId === userId,
+  delete: ({ userId, doc, role }) => doc.ownerId === userId || role === 'owner',
+};
+
+const LIBRARY_RULES = {
+  view: () => true,
+  audit: ({ role }) => role === 'owner',
+};
 
-/** Who may see a document: members of its library. */
 export function createAccess({ repos }) {
+  const roleIn = (libraryId, userId) => (userId ? repos.libraries.membership(libraryId, userId)?.role || null : null);
+
   function canSee(userId, doc) {
-    return Boolean(doc) && repos.libraries.isMember(doc.libraryId, userId);
+    return Boolean(doc) && Boolean(roleIn(doc.libraryId, userId));
+  }
+
+  function can(userId, action, doc) {
+    const rule = RULES[action];
+    if (!rule) {
+      throw new Error(`unknown action ${action}`);
+    }
+    const role = doc ? roleIn(doc.libraryId, userId) : null;
+    return Boolean(role) && rule({ userId, doc, role });
+  }
+
+  /** The document, if `userId` may do `action` to it; 404 if they cannot see it, 403 if they may not act. */
+  function require(userId, action, id) {
+    const doc = repos.documents.find(id);
+    if (!canSee(userId, doc)) {
+      throw notFound();
+    }
+    if (!can(userId, action, doc)) {
+      throw forbidden();
+    }
+    return doc;
+  }
+
+  function canLibrary(userId, action, libraryId) {
+    const role = roleIn(libraryId, userId);
+    return Boolean(role) && LIBRARY_RULES[action]({ userId, role });
   }
+
+  /** The library, if `userId` may do `action` in it; 404 for non-members, 403 otherwise. */
+  function requireLibrary(userId, action, libraryId) {
+    const library = libraryId ? repos.libraries.find(libraryId) : null;
+    if (!library || !roleIn(library.id, userId)) {
+      throw notFound();
+    }
+    if (!canLibrary(userId, action, library.id)) {
+      throw forbidden();
+    }
+    return library;
+  }
+
   return {
+    can,
     canSee,
+    canLibrary,
+    require,
+    requireLibrary,
     /** The document, or not_found for anyone who may not see it. */
-    visibleDocument(userId, id) {
-      const doc = repos.documents.find(id);
-      if (!canSee(userId, doc)) {
-        throw notFound();
-      }
-      return doc;
-    },
-    role(userId, libraryId) {
-      return repos.libraries.membership(libraryId, userId)?.role || null;
-    },
+    visibleDocument: (userId, id) => require(userId, 'view', id),
+    role: roleIn,
   };
 }
