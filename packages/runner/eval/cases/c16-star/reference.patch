 import { escapeHtml, layout } from './format.mjs';
 
-export function libraryPage(store, userId, { q = '' } = {}) {
-  const documents = store.listDocuments(userId, { q });
-  const rows = documents.map(d => `<li data-testid="doc-row" data-id="${d.id}"><a class="title" href="/documents/${d.id}">${escapeHtml(d.title)}</a><div class="meta"></div></li>`).join('');
+export function libraryPage(store, userId, { q = '', starred = false } = {}) {
+  const documents = store.starredFirst(userId, store.listDocuments(userId, { q }), { onlyStarred: starred });
+  const row = (d) => {
+    const on = store.isStarred(userId, d.id);
+    return `<li data-testid="doc-row" data-id="${d.id}"><button data-testid="star" aria-pressed="${on}" aria-label="Star">${on ? '\u2605' : '\u2606'}</button><a class="title" href="/documents/${d.id}">${escapeHtml(d.title)}</a><div class="meta"></div></li>`;
+  };
+  const stars = documents.filter(d => store.isStarred(userId, d.id));
+  const rest = documents.filter(d => !store.isStarred(userId, d.id));
+  const rows = `${stars.length ? `<li><h2 data-testid="starred-heading">Starred</h2></li>${stars.map(row).join('')}` : ''}${rest.map(row).join('')}`;
   const list = documents.length ? `<ul data-testid="library">${rows}</ul>` : '<p data-testid="empty">No documents</p>';
   return layout('Library', `<h1>Library</h1><form role="search" action="/"><input name="q" value="${escapeHtml(q)}"></form>${list}`);
 }
diff --git a/test/star.test.mjs b/test/star.test.mjs
new file mode 100644
index 0000000..b7c36cd
--- /dev/null
+++ b/test/star.test.mjs
@@ -0,0 +1,11 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { handle } from '../src/api.mjs';
+import { createStore } from '../src/store.mjs';
+
+test('a starred document comes first for that person only', () => {
+  const store = createStore();
+  handle(store, { method: 'PUT', path: '/api/documents/d3/star', body: { starred: true }, userId: 'u_owner' });
+  assert.equal(handle(store, { path: '/api/documents', userId: 'u_owner' }).body.documents[0].id, 'd3');
+  assert.equal(handle(store, { path: '/api/documents', userId: 'u_teammate' }).body.documents[0].id, 'd2');
+});
