 import { seed } from './data.mjs';
 
+export const SORTS = ['name', 'uploaded', 'opened'];
+
+function sorter(store, sort) {
+  const newest = (a, b) => b.uploadedAt.localeCompare(a.uploadedAt);
+  if (sort === 'name') {
+    return (a, b) => a.title.localeCompare(b.title, 'en', { sensitivity: 'base' });
+  }
+  if (sort === 'opened') {
+    return (a, b) => {
+      const x = store.lastOpenedAt(a.id);
+      const y = store.lastOpenedAt(b.id);
+      if (x === y) {
+        return newest(a, b);
+      }
+      if (!x || !y) {
+        return x ? -1 : 1;
+      }
+      return y.localeCompare(x);
+    };
+  }
+  return newest;
+}
+
