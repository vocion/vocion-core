diff --git a/test/rename.test.mjs b/test/rename.test.mjs
new file mode 100644
index 0000000..acb9fb5
--- /dev/null
+++ b/test/rename.test.mjs
@@ -0,0 +1,12 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { handle } from '../src/api.mjs';
+import { createStore } from '../src/store.mjs';
+
+test('the owner renames a document; a blank name is refused', () => {
+  const store = createStore();
+  assert.equal(handle(store, { method: 'PATCH', path: '/api/documents/d1', body: { title: ' New ' }, userId: 'u_owner' }).status, 200);
+  assert.equal(store.findDocument('d1').title, 'New');
+  assert.equal(handle(store, { method: 'PATCH', path: '/api/documents/d1', body: { title: ' ' }, userId: 'u_owner' }).status, 400);
+  assert.equal(handle(store, { method: 'PATCH', path: '/api/documents/d1', body: { title: 'x' }, userId: 'u_teammate' }).status, 403);
+});
