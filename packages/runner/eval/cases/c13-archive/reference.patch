diff --git a/test/archive.test.mjs b/test/archive.test.mjs
new file mode 100644
index 0000000..4d4cb98
--- /dev/null
+++ b/test/archive.test.mjs
@@ -0,0 +1,12 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { handle } from '../src/api.mjs';
+import { createStore } from '../src/store.mjs';
+
+test('an archived document leaves the library and its links stop', () => {
+  const store = createStore();
+  assert.equal(handle(store, { method: 'POST', path: '/api/documents/d1/archive', userId: 'u_teammate' }).status, 403);
+  assert.equal(handle(store, { method: 'POST', path: '/api/documents/d1/archive', userId: 'u_owner' }).status, 200);
+  assert.equal(handle(store, { path: '/api/documents', userId: 'u_owner' }).body.documents.length, 4);
+  assert.equal(handle(store, { path: '/l/l1' }).status, 410);
+});
