diff --git a/src/emails/index.mjs b/src/emails/index.mjs
new file mode 100644
index 0000000..6622ac4
--- /dev/null
+++ b/src/emails/index.mjs
@@ -0,0 +1,32 @@
+// Every email's words, in one place. render(type, data) returns { subject, body } from plain data;
+// services decide who gets what and when, and never write copy themselves. Dates are UTC.
+import { formatShortDay } from '../lib/time.mjs';
+
+const APP_URL = 'https://dataroom.northwind.example';
+const linkUrl = linkId => `${APP_URL}/l/${linkId}`;
+
+const TEMPLATES = {
+  /** { ownerName, docTitle, linkId } */
+  'link.shared': ({ ownerName, docTitle, linkId }) => ({
+    subject: `${ownerName} shared "${docTitle}" with you`,
+    body: `${ownerName} shared "${docTitle}" with you on Northwind Dataroom.\n\nOpen it: ${linkUrl(linkId)}\n`,
+  }),
+  /** { ownerName, docTitle, linkId, sharedAt } */
+  'reminder': ({ ownerName, docTitle, linkId, sharedAt }) => ({
+    subject: `Reminder: ${ownerName} shared "${docTitle}" with you`,
+    body: `${ownerName} shared "${docTitle}" with you on ${formatShortDay(sharedAt)} and it has not been opened yet.\n\nOpen it: ${linkUrl(linkId)}\n`,
+  }),
+  /** { libraryName, weekStart, lines: [{ title, opens }] } */
+  'digest': ({ libraryName, weekStart, lines }) => ({
+    subject: `Your week in ${libraryName}`,
+    body: `Week of ${formatShortDay(weekStart)}\n\n${lines.map(l => `- ${l.title}: ${l.opens} opens`).join('\n')}\n`,
+  }),
+};
+
+export function render(type, data) {
+  const template = TEMPLATES[type];
+  if (!template) {
+    throw new Error(`no email template for ${type}`);
+  }
+  return template(data);
+}
