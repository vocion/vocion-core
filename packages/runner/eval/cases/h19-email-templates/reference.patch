diff --git a/test/emails.test.mjs b/test/emails.test.mjs
new file mode 100644
index 0000000..2c65da1
--- /dev/null
+++ b/test/emails.test.mjs
@@ -0,0 +1,10 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { render } from '../src/emails/index.mjs';
+
+test('emails render from plain data', () => {
+  assert.equal(render('link.shared', { ownerName: 'Olivia Park', docTitle: 'Deck', linkId: 'l1' }).subject, 'Olivia Park shared "Deck" with you');
+  assert.match(render('reminder', { ownerName: 'O', docTitle: 'D', linkId: 'l1', sharedAt: '2026-09-30T09:00:00.000Z' }).body, /on Sep 30 /);
+  assert.equal(render('digest', { libraryName: 'L', weekStart: '2026-10-05T00:00:00.000Z', lines: [] }).body, 'Week of Oct 5\n\n\n');
+  assert.throws(() => render('unknown', {}));
+});
