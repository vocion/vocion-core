diff --git a/src/http/routes/members.mjs b/src/http/routes/members.mjs
new file mode 100644
index 0000000..c7339d5
--- /dev/null
+++ b/src/http/routes/members.mjs
@@ -0,0 +1,54 @@
+import { badRequest, forbidden, notFound } from '../../lib/validate.mjs';
+import { ROLES } from '../../services/access.mjs';
+
+const view = m => ({ userId: m.userId, libraryId: m.libraryId, role: m.role });
+
+/** The library, for one of its owners: 404 for anyone not in it, 403 for other members. */
+function ownedLibrary(repos, libraryId, userId) {
+  const library = repos.libraries.find(libraryId);
+  const role = library && repos.libraries.membership(library.id, userId)?.role;
+  if (!role) {
+    throw notFound();
+  }
+  if (role !== 'owner') {
+    throw forbidden();
+  }
+  return library;
+}
+
+export const memberRoutes = [
+  ['POST', '/api/libraries/:id/members', ({ user, params, body, repos, clock }) => {
+    const library = ownedLibrary(repos, params.id, user.id);
+    if (!ROLES.includes(body.role)) {
+      throw badRequest('invalid_role');
+    }
+    const member = repos.users.byEmail(body.email);
+    if (!member) {
+      throw badRequest('unknown_user');
+    }
+    if (repos.libraries.membership(library.id, member.id)) {
+      throw badRequest('already_member');
+    }
+    const m = repos.libraries.addMember(library.id, member.id, body.role);
+    repos.audit.write({ at: clock.now(), actorId: user.id, action: 'member.added', targetId: library.id, detail: { userId: member.id, role: body.role } });
+    return { status: 201, json: { member: view(m) } };
+  }],
+
+  ['PATCH', '/api/libraries/:id/members/:userId', ({ user, params, body, repos, clock }) => {
+    const library = ownedLibrary(repos, params.id, user.id);
+    if (!ROLES.includes(body.role)) {
+      throw badRequest('invalid_role');
+    }
+    const m = repos.libraries.membership(library.id, params.userId);
+    if (!m) {
+      throw notFound();
+    }
+    const owners = repos.libraries.members(library.id).filter(x => x.role === 'owner');
+    if (m.role === 'owner' && body.role !== 'owner' && owners.length === 1) {
+      throw badRequest('last_owner');
+    }
+    const updated = repos.libraries.setRole(m.id, body.role);
+    repos.audit.write({ at: clock.now(), actorId: user.id, action: 'member.role_changed', targetId: library.id, detail: { userId: m.userId, from: m.role, to: body.role } });
+    return { json: { member: view(updated) } };
+  }],
+];
