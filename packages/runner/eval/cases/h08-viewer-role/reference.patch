@@ -1,4 +1,6 @@
-import { notFound } from '../lib/validate.mjs';
+import { forbidden, notFound } from '../lib/validate.mjs';
+
+export const ROLES = ['owner', 'editor', 'viewer'];
 
 /** Who may see a document: members of its library. */
 export function createAccess({ repos }) {
@@ -18,5 +20,21 @@ export function createAccess({ repos }) {
     role(userId, libraryId) {
       return repos.libraries.membership(libraryId, userId)?.role || null;
     },
+    /** Viewers read; owners and editors change things. */
+    canEdit(userId, libraryId) {
+      const role = repos.libraries.membership(libraryId, userId)?.role;
+      return Boolean(role) && role !== 'viewer';
+    },
+    /** The document, for a member who may change it: 404 if they cannot see it, 403 for a viewer. */
+    editableDocument(userId, id) {
+      const doc = repos.documents.find(id);
+      if (!canSee(userId, doc)) {
+        throw notFound();
+      }
+      if (repos.libraries.membership(doc.libraryId, userId)?.role === 'viewer') {
+        throw forbidden();
+      }
+      return doc;
+    },
   };
 }
