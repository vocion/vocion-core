diff --git a/test/members.test.mjs b/test/members.test.mjs
new file mode 100644
index 0000000..d8e2cc5
--- /dev/null
+++ b/test/members.test.mjs
@@ -0,0 +1,20 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { createApp, request } from './helpers.mjs';
+
+const call = (app, user, method, path, body) => request(app, { method, path, user, body });
+
+test('owners add viewers, who read but change nothing', async () => {
+  const app = createApp();
+  assert.equal((await call(app, 'u_owner', 'POST', '/api/libraries/lib_team/members', { email: 'ana@acme.example', role: 'viewer' })).status, 201);
+  assert.equal((await call(app, 'u_other', 'GET', '/api/documents/d1')).status, 200);
+  assert.equal((await call(app, 'u_other', 'PATCH', '/api/documents/d1', { title: 'x' })).status, 403);
+  assert.equal((await call(app, 'u_other', 'POST', '/api/documents/d1/links', { recipientEmail: 'a@b.example' })).status, 403);
+  assert.equal((await call(app, 'u_other', 'GET', '/api/documents/d1/analytics')).status, 403);
+});
+
+test('the last owner cannot be demoted', async () => {
+  const app = createApp();
+  const r = await call(app, 'u_owner', 'PATCH', '/api/libraries/lib_team/members/u_owner', { role: 'editor' });
+  assert.equal(r.body.error, 'last_owner');
+});
