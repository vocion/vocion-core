index 3471d73..3e91d6f 100644
--- a/src/store.mjs
+++ b/src/store.mjs
@@ -1,3 +1,4 @@
+import { randomBytes, scryptSync, timingSafeEqual } from 'node:crypto';
 import { seed } from './data.mjs';
 
 // The data in memory and the queries over it. `store.db` is the data itself.
@@ -27,6 +28,24 @@ export function createStore(data = seed()) {
       db.links.push(link);
       return link;
     },
+    setPasscode(link, passcode) {
+      if (passcode === null) {
+        delete link.passcodeHash;
+        return;
+      }
+      const salt = randomBytes(16).toString('hex');
+      link.passcodeHash = `${salt}:${scryptSync(passcode, salt, 32).toString('hex')}`;
+    },
+    checkPasscode(link, passcode) {
+      if (!link.passcodeHash) {
+        return true;
+      }
+      if (typeof passcode !== 'string' || !passcode) {
+        return false;
+      }
+      const [salt, hash] = link.passcodeHash.split(':');
+      return timingSafeEqual(Buffer.from(hash, 'hex'), scryptSync(passcode, salt, 32));
+    },
     recordView(docId, { viewerId, linkId = null }) {
       const view = { docId, linkId, viewerId, at: db.now };
       db.views.push(view);
