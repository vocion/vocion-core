diff --git a/test/passcode.test.mjs b/test/passcode.test.mjs
new file mode 100644
index 0000000..a074758
--- /dev/null
+++ b/test/passcode.test.mjs
@@ -0,0 +1,12 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { handle } from '../src/api.mjs';
+import { createStore } from '../src/store.mjs';
+
+test('a passcode locks a link until it is given', () => {
+  const store = createStore();
+  assert.equal(handle(store, { method: 'PUT', path: '/api/documents/d1/links/l1/passcode', body: { passcode: 'tiger42' }, userId: 'u_owner' }).status, 200);
+  assert.equal(handle(store, { path: '/l/l1' }).status, 401);
+  assert.equal(handle(store, { path: '/l/l1', query: { passcode: 'tiger42' } }).status, 200);
+  assert.doesNotMatch(JSON.stringify(store.db.links), /tiger42/);
+});
