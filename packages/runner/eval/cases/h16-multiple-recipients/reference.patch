@@ -0,0 +1,9 @@
+// A link can have several recipients. Existing links get their one recipient as the list;
+// recipientEmail stays, always the first recipient, for older readers.
+export default {
+  version: 4,
+  name: 'recipients',
+  up(db) {
+    db.addColumn('links', 'recipients', row => (row.recipientEmail ? [row.recipientEmail] : []));
+  },
+};
