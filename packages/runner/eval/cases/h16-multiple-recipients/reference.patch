+test('a link can have several recipients, each with their own address and reminders', async () => {
+  const app = createApp();
+  const r = await request(app, { method: 'POST', path: '/api/documents/d2/links', user: 'u_owner', body: { recipients: ['amy@kestrel.example', 'ben@kestrel.example'] } });
