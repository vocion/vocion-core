diff --git a/test/not-opened.test.mjs b/test/not-opened.test.mjs
new file mode 100644
index 0000000..e4c7050
--- /dev/null
+++ b/test/not-opened.test.mjs
@@ -0,0 +1,14 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { handle } from '../src/api.mjs';
+import { createStore } from '../src/store.mjs';
+
+test('the not-opened filter ignores the owner and drops a document a visitor opened', () => {
+  const store = createStore();
+  const ids = () => handle(store, { path: '/api/documents', query: { notOpened: '1' }, userId: 'u_owner' }).body.documents.map(d => d.id);
+  assert.deepEqual(ids(), ['d4']);
+  handle(store, { path: '/l/l4', userId: 'u_owner' });
+  assert.deepEqual(ids(), ['d4']);
+  handle(store, { path: '/l/l4', query: { viewer: 'legal@contoso.example' } });
+  assert.deepEqual(ids(), []);
+});
