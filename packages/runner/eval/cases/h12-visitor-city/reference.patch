new file mode 100644
index 0000000..e9be612
--- /dev/null
+++ b/src/lib/browsers.mjs
@@ -0,0 +1,13 @@
+// The browser family of a user agent, as the activity page names it. Order matters: Edge and
+// Chrome also claim Safari, and Edge also claims Chrome.
+const FAMILIES = [
+  ['Edge', /Edg\//],
+  ['Chrome', /Chrome\//],
+  ['Firefox', /Firefox\//],
+  ['Safari', /Safari\//],
+];
+
+export function browserName(userAgent) {
+  const ua = String(userAgent || '');
+  return FAMILIES.find(([, re]) => re.test(ua))?.[0] || 'Other';
+}
