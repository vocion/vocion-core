{
  "name": "@vocion/core",
  "version": "0.1.0",
  "private": true,
  "description": "Vocion — Next.js app, Postgres schema, MCP server, workflow runner.",
  "license": "MPL-2.0",
  "engines": {
    "node": ">=20.3"
  },
  "scripts": {
    "dev:spotlight": "npx @spotlightjs/spotlight",
    "dev:next": "next dev",
    "dev": "run-p db-server:file dev:*",
    "build:next": "next build",
    "build-local": "run-p db-server:memory build:next --race",
    "build": "run-s db:migrate version:write build:next docs:index",
    "docs:index": "pagefind --site .next/server/app --output-path public/pagefind",
    "docs:lint": "dotenv -c -- tsx src/scripts/audit-doc-links.ts",
    "docs:ingest": "dotenv -c -- tsx src/scripts/ingest-docs.ts",
    "seed:demo": "dotenv -c -- tsx src/scripts/seed-demo.ts",
    "adoption:backfill": "dotenv -c -- tsx src/scripts/backfill-adoption-events.ts",
    "voice:relint": "dotenv -c -- tsx src/scripts/relint-pending-enrolls.ts",
    "adoption:seed-demo": "dotenv -c -- tsx src/scripts/seed-adoption-demo.ts",
    "start": "next start",
    "build-stats": "cross-env ANALYZE=true npm run build",
    "clean": "rimraf .next out coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check:types": "tsc --noEmit --pretty",
    "check:i18n": "i18n-check -l src/locales -s en -u src -f next-intl",
    "check:migrations": "tsx src/scripts/check-migration-safety.ts",
    "check:symlinks": "tsx src/scripts/check-tracked-symlinks.ts",
    "openapi:generate": "tsx src/scripts/generate-openapi.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "e2e:chat-incomplete": "VOCION_LLM_PROVIDER=scripted VOCION_LLM_SCRIPT=e2e/chat-incomplete/scripts/mid-stream-failure.json WORKSPACE_PATH=templates/workspaces/client-documents VOCION_DISABLE_RUNTIME=1 playwright test --project=chat-incomplete --workers=1",
    "e2e:documents": "VOCION_LLM_PROVIDER=scripted VOCION_LLM_SCRIPT=e2e/documents/scripts/proposal-loop.json WORKSPACE_PATH=templates/workspaces/client-documents VOCION_DISABLE_RUNTIME=1 playwright test --project=documents --workers=1",
    "db-server:file": "pglite-server --extensions=vector --db=local.db --run 'npm run db:migrate'",
    "db-server:memory": "pglite-server --extensions=vector --run 'npm run db:migrate'",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "dotenv -c -- drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "creds:set": "dotenv -c -- tsx src/scripts/set-credential.ts",
    "google:oauth": "dotenv -c -- tsx src/scripts/google-oauth.ts",
    "sync:source": "dotenv -c -- tsx src/scripts/sync-source.ts",
    "kit:inspect": "dotenv -c -- tsx src/scripts/kit-inspect.ts",
    "workspace:scaffold": "tsx src/scripts/scaffold-workspace.ts",
    "workspace:apply": "dotenv -c -- tsx src/scripts/apply-workspace.ts",
    "workspace:check": "dotenv -c -- tsx src/scripts/apply-workspace.ts --dry-run",
    "workspace:export": "dotenv -c -- tsx src/scripts/export-workspace.ts",
    "discovery:seed": "dotenv -c -- tsx src/scripts/seed-discovery-window.ts",
    "tokens:issue": "dotenv -c -- tsx src/scripts/manage-tokens.ts issue",
    "tokens:list": "dotenv -c -- tsx src/scripts/manage-tokens.ts list",
    "tokens:revoke": "dotenv -c -- tsx src/scripts/manage-tokens.ts revoke",
    "personalization:seed": "dotenv -c -- tsx src/scripts/seed-personalization-queue.ts",
    "local:reset-password": "dotenv -c -- tsx src/scripts/reset-local-password.ts",
    "local:setup-projects": "dotenv -c -- tsx src/scripts/setup-local-projects.ts",
    "mcp:serve": "dotenv -c -- tsx src/interfaces/mcp/bin.ts",
    "worker:serve": "dotenv -c -- tsx src/scripts/worker-serve.ts",
    "temporal:worker": "dotenv -c -- tsx src/scripts/temporal-worker.ts",
    "langfuse:smoke": "dotenv -c -- tsx src/scripts/smoke-langfuse.ts",
    "langfuse:bootstrap": "dotenv -c -- tsx src/scripts/langfuse-bootstrap.ts",
    "eval:run": "dotenv -c -- tsx src/scripts/run-evals.ts",
    "report:daily": "dotenv -c -- tsx src/scripts/report-daily.ts",
    "eval:upgrade": "dotenv -c -- tsx src/scripts/model-upgrade-test.ts",
    "storybook": "storybook dev -p 6006",
    "storybook:test": "vitest run --config .storybook/vitest.config.mts",
    "build-storybook": "storybook build",
    "stripe:listen": "stripe listen --forward-to localhost:3000/webhook/billing",
    "stripe:setup-price": "dotenv -c production -- tsx ./scripts/createStripePrice.ts",
    "e2e:demo": "dotenv -c -- tsx src/scripts/e2e-demo.ts",
    "connectors:backfill-credentials": "dotenv -c -- tsx src/scripts/backfill-connector-credentials.ts",
    "user:create": "dotenv -c -- tsx src/scripts/create-local-user.ts",
    "consolidate:run": "dotenv -c -- tsx src/scripts/run-consolidation.ts",
    "artifacts:sweep": "dotenv -c -- tsx src/scripts/sweep-artifacts.ts",
    "version:write": "node scripts/write-version.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.88.0",
    "@auth/drizzle-adapter": "^1.11.2",
    "@aws-sdk/client-bedrock-agentcore": "^3.1079.0",
    "@aws-sdk/client-bedrock-agentcore-control": "^3.1079.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1085.0",
    "@aws-sdk/client-kms": "^3.1045.0",
    "@aws-sdk/client-rekognition": "^3.1124.0",
    "@aws-sdk/client-s3": "^3.1124.0",
    "@aws-sdk/client-sts": "^3.1079.0",
    "@aws-sdk/s3-request-presigner": "^3.1124.0",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@electric-sql/pglite": "^0.3.15",
    "@langchain/anthropic": "^1.3.29",
    "@langchain/aws": "^1.0.4",
    "@langchain/core": "^1.1.45",
    "@langchain/langgraph": "^1.3.0",
    "@langchain/openai": "^1.4.5",
    "@logtape/logtape": "^2.0.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@orpc/client": "^1.13.6",
    "@orpc/server": "^1.13.6",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/nextjs": "^10.42.0",
    "@t3-oss/env-nextjs": "^0.13.10",
    "@tanstack/react-table": "^8.21.3",
    "@temporalio/client": "^1.17.1",
    "@temporalio/worker": "^1.17.1",
    "@temporalio/workflow": "^1.17.1",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@uiw/react-codemirror": "^4.25.9",
    "@vocion/sdk": "*",
    "ajv": "^8.17.1",
    "bcrypt": "^6.0.0",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cronstrue": "^3.24.0",
    "deepagents": "1.10.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.1",
    "gray-matter": "^4.0.3",
    "js-tiktoken": "^1.0.21",
    "langchain": "^1.4.0",
    "langfuse": "^3.38.6",
    "lucide-react": "^0.577.0",
    "next": "^16.1.6",
    "next-auth": "^5.0.0-beta.31",
    "next-intl": "^4.8.3",
    "next-themes": "^0.4.6",
    "openai": "^6.32.0",
    "papaparse": "^5.5.3",
    "pdf-parse": "^2.4.5",
    "pg": "^8.20.0",
    "playwright": "^1.58.2",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.71.2",
    "react-markdown": "^10.1.0",
    "rehype-slug": "^6.0.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.34.5",
    "stripe": "^18.5.0",
    "swagger-ui-react": "^5.33.0",
    "tailwind-merge": "^3.5.0",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@chromatic-com/playwright": "^0.12.8",
    "@electric-sql/pglite-socket": "^0.0.20",
    "@faker-js/faker": "^10.3.0",
    "@lingual/i18n-check": "^0.8.19",
    "@next/bundle-analyzer": "^16.1.6",
    "@playwright/test": "^1.58.2",
    "@spotlightjs/spotlight": "^4.10.0",
    "@storybook/addon-a11y": "^10.2.15",
    "@storybook/addon-docs": "^10.2.15",
    "@storybook/addon-vitest": "^10.2.15",
    "@storybook/nextjs-vite": "^10.2.15",
    "@swc/helpers": "^0.5.19",
    "@tailwindcss/postcss": "^4.2.1",
    "@tailwindcss/typography": "^0.5.19",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^25.3.5",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.18.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "@types/swagger-ui-react": "^5.18.0",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/browser": "^4.0.18",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "babel-plugin-react-compiler": "^1.0.0",
    "checkly": "^7.5.2",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.9",
    "npm-run-all": "^4.1.5",
    "pagefind": "^1.5.2",
    "postcss": "^8.5.8",
