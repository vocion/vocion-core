{
  "name": "@vocion/core",
  "version": "0.1.0",
  "private": true,
  "description": "Vocion — Next.js app, Postgres schema, MCP server, workflow runner.",
  "license": "MPL-2.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:spotlight": "npx @spotlightjs/spotlight",
    "dev:next": "next dev",
    "dev": "run-p db-server:file dev:*",
    "build:next": "next build --webpack",
    "build-local": "run-p db-server:memory build:next --race",
    "build": "run-s db:migrate build:next docs:index",
    "docs:index": "pagefind --site .next/server/app --output-path public/pagefind",
    "docs:lint": "dotenv -c -- tsx src/scripts/audit-doc-links.ts",
    "docs:ingest": "dotenv -c -- tsx src/scripts/ingest-docs.ts",
    "seed:demo": "dotenv -c -- tsx src/scripts/seed-demo.ts",
    "adoption:backfill": "dotenv -c -- tsx src/scripts/backfill-adoption-events.ts",
    "adoption:seed-demo": "dotenv -c -- tsx src/scripts/seed-adoption-demo.ts",
    "start": "next start",
    "build-stats": "cross-env ANALYZE=true npm run build",
    "clean": "rimraf .next out coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check:types": "tsc --noEmit --pretty",
    "check:i18n": "i18n-check -l src/locales -s en -u src -f next-intl",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db-server:file": "pglite-server --extensions=vector --db=local.db --run 'npm run db:migrate'",
    "db-server:memory": "pglite-server --extensions=vector --run 'npm run db:migrate'",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "dotenv -c -- drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "creds:set": "dotenv -c -- tsx src/scripts/set-credential.ts",
    "google:oauth": "dotenv -c -- tsx src/scripts/google-oauth.ts",
    "sync:source": "dotenv -c -- tsx src/scripts/sync-source.ts",
    "workspace:scaffold": "tsx src/scripts/scaffold-workspace.ts",
    "workspace:apply": "dotenv -c -- tsx src/scripts/apply-workspace.ts",
    "workspace:check": "dotenv -c -- tsx src/scripts/apply-workspace.ts --dry-run",
    "workspace:export": "dotenv -c -- tsx src/scripts/export-workspace.ts",
    "discovery:seed": "dotenv -c -- tsx src/scripts/seed-discovery-window.ts",
    "mcp:serve": "dotenv -c -- tsx src/interfaces/mcp/bin.ts",
    "worker:serve": "dotenv -c -- tsx src/scripts/worker-serve.ts",
    "temporal:worker": "dotenv -c -- tsx src/scripts/temporal-worker.ts",
    "langfuse:smoke": "dotenv -c -- tsx src/scripts/smoke-langfuse.ts",
    "langfuse:bootstrap": "dotenv -c -- tsx src/scripts/langfuse-bootstrap.ts",
    "eval:run": "dotenv -c -- tsx src/scripts/run-evals.ts",
    "storybook": "storybook dev -p 6006",
    "storybook:test": "vitest run --config .storybook/vitest.config.mts",
    "build-storybook": "storybook build",
    "stripe:listen": "stripe listen --forward-to localhost:3000/webhook/billing",
    "stripe:setup-price": "dotenv -c production -- tsx ./scripts/createStripePrice.ts",
    "e2e:demo": "dotenv -c -- tsx src/scripts/e2e-demo.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.39",
    "@ai-sdk/openai": "^4.0.42",
    "@anthropic-ai/sdk": "^0.117.1",
    "@auth/drizzle-adapter": "^1.11.3",
    "@aws-sdk/client-bedrock-agentcore": "^3.1111.0",
    "@aws-sdk/client-bedrock-agentcore-control": "^3.1111.0",
    "@aws-sdk/client-kms": "^3.1111.0",
    "@aws-sdk/client-sts": "^3.1111.0",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@langchain/anthropic": "^1.5.6",
    "@langchain/core": "^1.1.45",
    "@langchain/openai": "^1.5.8",
    "@logtape/logtape": "^2.3.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@orpc/client": "^1.15.0",
    "@orpc/server": "^1.15.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@sentry/nextjs": "^10.70.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-table": "^8.21.3",
    "@temporalio/client": "^1.22.0",
    "@temporalio/worker": "^1.22.0",
    "@temporalio/workflow": "^1.17.1",
    "@uiw/react-codemirror": "^4.25.11",
    "@vocion/sdk": "*",
    "ai": "^7.0.66",
    "bcrypt": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cronstrue": "^3.24.0",
    "deepagents": "1.12.4",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "gray-matter": "^4.0.3",
    "js-tiktoken": "^1.0.21",
    "langfuse": "^3.38.20",
    "lucide-react": "^0.577.0",
    "next": "^16.3.1",
    "next-auth": "^5.0.0-beta.31",
    "next-intl": "^4.13.7",
    "next-themes": "^0.4.6",
    "openai": "^6.32.0",
    "papaparse": "^5.6.0",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "react-markdown": "^10.1.0",
    "rehype-slug": "^6.0.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "stripe": "^18.5.0",
    "tailwind-merge": "^3.6.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@chromatic-com/playwright": "^0.14.11",
    "@clerk/testing": "^1.14.9",
    "@electric-sql/pglite": "^0.5.5",
    "@electric-sql/pglite-socket": "^0.2.8",
    "@faker-js/faker": "^10.6.0",
    "@lingual/i18n-check": "^0.9.5",
    "@next/bundle-analyzer": "^16.3.1",
    "@playwright/test": "^1.62.1",
    "@spotlightjs/spotlight": "^4.11.8",
    "@storybook/addon-a11y": "^10.5.8",
    "@storybook/addon-docs": "^10.5.8",
    "@storybook/addon-vitest": "^10.5.8",
    "@storybook/nextjs-vite": "^10.5.8",
    "@swc/helpers": "^0.5.19",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^25.9.5",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "babel-plugin-react-compiler": "^1.0.0",
    "checkly": "^7.15.0",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "npm-run-all": "^4.1.5",
    "pagefind": "^1.5.2",
    "postcss": "^8.5.8",
    "postcss-load-config": "^6.0.1",
    "rimraf": "^6.1.3",
    "storybook": "^10.2.15",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.23.12",
    "tw-animate-css": "^1.4.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10",
    "vitest-browser-react": "^2.2.0"
  }
}
