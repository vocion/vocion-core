// knip config. JSONC so an exception can say why it exists — a gate whose
// entries nobody can explain is a gate people learn to bypass (ticket 046).
{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "docker-compose.yml",
        "infra/**/*.{yml,yaml,sh,tf}"
      ],
      "ignoreDependencies": [
        "conventional-changelog-conventionalcommits",
        "@commitlint/types"
      ]
    },
    "packages/core": {
      "entry": [
        "src/app/**/{page,layout,route,loading,error,not-found,sitemap,robots,opengraph-image,twitter-image,icon,apple-icon}.{ts,tsx}",
        "src/instrumentation*.ts",
        "src/scripts/*.ts",
        "tests/**/*.{ts,tsx}",
        ".storybook/**/*.{ts,tsx}",
        "checkly.config.ts",
        "src/libs/workspace/ext-stub/registry.tsx"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "!src/**/*.test.{ts,tsx}"
      ],
      "ignore": [
        "src/components/ui/**",
        "src/features/dashboard/chat/**",
        "src/features/auth/ProtectFallback.tsx",
        "src/features/dashboard/ContextMenu.tsx",
        "src/features/dashboard/DraftCard.tsx",
        "src/features/dashboard/EmailDraftCard.tsx",
        "src/features/dashboard/ProposalCard.tsx",
        "src/types/**",
        "src/libs/plugins/**",
        "src/libs/retrieval/**",
        "src/libs/llm/**",
        "src/libs/temporal/**",
        "src/libs/crypto/**",
        "src/libs/docs/**",
        "src/libs/I18n.ts",
        "src/libs/agentAccent.ts",
        "src/libs/Langfuse.ts",
        "src/services/**",
        "src/routers/**"
      ],
      "ignoreDependencies": [
        "@radix-ui/react-accordion",
        "@radix-ui/react-popover",
        "@tanstack/react-table",
        "react-hook-form",
        "@swc/helpers",
        "@tailwindcss/typography",
        "tailwindcss",
        "tw-animate-css",
        "@clerk/nextjs",
        "vite",
        "@wsx/registry"
      ],
      "includeEntryExports": false
    },
    "packages/sdk": {
      "project": [
        "src/**/*.ts"
      ],
      "ignoreDependencies": [
        "react"
      ]
    },
    "packages/plugins/*": {
      "project": [
        "src/**/*.ts"
      ]
    }
  },
  "ignoreBinaries": [
    "dotenv",
    "tofu",
    "production",
    "checkly",
    "stripe",
    "vitest"
  ],
  "rules": {
    "exports": "off",
    "types": "off",
    "duplicates": "off"
  }
}
